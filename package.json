{
  "name": "orizn",
  "version": "1.2.1",
  "description": "Official SDK for the Orizn Visa API — 40,027 passport-destination pairs in 15 languages (all plans), 30+ data points per visa: fees, processing times, photo specs, transit, embassies, overstay penalties, safety",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test.mjs"
  },
  "keywords": [
    "visa",
    "travel",
    "passport",
    "api",
    "sdk",
    "visa-requirements",
    "travel-api",
    "orizn",
    "immigration",
    "country-data",
    "multilingual"
  ],
  "author": "Orizn <api@orizn.app>",
  "license": "MIT",
  "homepage": "https://visa.orizn.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/MattJeff/orizn-js"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}
